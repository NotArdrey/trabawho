VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Browser key for service-address suggestions. Enable Maps JavaScript API and Places API (New).
# Restrict the key to the app's HTTP referrers and these APIs. Address entry works without it.
VITE_GOOGLE_MAPS_API_KEY=

# Optional raster tile provider for the service pin picker. Defaults to public OpenStreetMap tiles.
# Keep OpenStreetMap attribution visible and use a provider that permits OSM-only attribution.
# Example template: https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_URL=

# Fixed ad booster daily rate in PHP. Set the same rate in the Edge Function secrets.
VITE_AD_BOOST_DAILY_RATE_PHP=50
# Server-only Supabase Edge Function setting (defaults to 50):
# AD_BOOST_DAILY_RATE_PHP=50

# Temporary migration aliases; remove after deployment settings use VITE_*.
# REACT_APP_SUPABASE_URL=
# REACT_APP_SUPABASE_ANON_KEY=
